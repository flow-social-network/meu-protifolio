// Prisma Schema for NoteAgents / DEEVO CMS
// Target database: PostgreSQL (compatible with Neon)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  DEVELOPER
  SUPPORT
}

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentType {
  CLIENTE
  DESENVOLVEDOR
  PARCERIA
  SUPORTE
  OUTRO
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(ADMIN)
  avatarUrl    String?
  sessions     Session[]
  revisions    PageRevision[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Page {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  content        String
  excerpt        String?
  status         PageStatus     @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  featuredImage  String?
  revisions      PageRevision[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Post {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  featuredImage   String?
  category        String
  tags            String[]
  status          PostStatus @default(DRAFT)
  author          String     @default("Vini Amaral")
  readTimeMinutes Int        @default(5)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   @default("image")
  sizeBytes Int
  mimeType  String
  createdAt DateTime @default(now())
}

model Banner {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonUrl  String?
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Menu {
  id        String     @id @default(uuid())
  name      String
  location  String     @unique // "header" | "footer"
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Appointment {
  id               String            @id @default(uuid())
  type             AppointmentType   @default(CLIENTE)
  name             String
  email            String
  phone            String
  company          String?
  reason           String
  description      String
  isExistingClient Boolean           @default(false)
  preferredChannel String            @default("GOOGLE_MEET")
  date             String // YYYY-MM-DD
  time             String // HH:mm
  status           AppointmentStatus @default(SCHEDULED)
  internalNotes    String?
  assignedTo       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Project {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  tagline        String
  description    String
  technologies   String[]
  category       String         @default("AI")
  repositoryUrl  String?
  demoUrl        String?
  featured       Boolean        @default(false)
  media          ProjectMedia[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProjectMedia {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Integration {
  id          String   @id @default(uuid())
  provider    String   @unique
  name        String
  description String
  connected   Boolean  @default(false)
  config      Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model Repository {
  id          String   @id @default(uuid())
  name        String
  fullName    String   @unique
  url         String
  branch      String   @default("main")
  isPrivate   Boolean  @default(false)
  syncedAt    DateTime @default(now())
}

model Deployment {
  id          String   @id @default(uuid())
  environment String   @default("production")
  status      String   @default("ready")
  branch      String   @default("main")
  commitHash  String?
  commitMsg   String?
  url         String
  createdAt   DateTime @default(now())
}

model SeoSetting {
  id               String   @id @default("default")
  siteTitle        String   @default("NoteAgents — Engenharia de Software Assistida por IA")
  siteDescription  String   @default("Plataforma open source de engenharia de software assistida por IA. Coordena projetos, agentes, código, testes, observabilidade e deployment.")
  keywords         String[]
  canonicalBaseUrl String   @default("https://deevo.com.br")
  ogTitle          String   @default("NoteAgents — Engenharia de Software Assistida por IA")
  ogDescription    String   @default("Plataforma open source de engenharia de software assistida por IA.")
  ogImage          String   @default("/icon.svg")
  indexingEnabled  Boolean  @default(true)
  autoSitemap      Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model SiteSetting {
  id             String   @id @default("default")
  siteName       String   @default("DEEVO Soluções Financeiras & NoteAgents")
  tagline        String   @default("Transformando ideias em soluções digitais reais.")
  siteUrl        String   @default("https://deevo.com.br")
  contactEmail   String   @default("contato@deevo.com.br")
  contactPhone   String   @default("+55 (11) 99999-9999")
  address        String   @default("Brasil")
  language       String   @default("pt-BR")
  timezone       String   @default("America/Sao_Paulo")
  githubUrl      String   @default("https://github.com/deevo-solucoes")
  linkedinUrl    String   @default("https://linkedin.com/in/viniamaral")
  whatsappNumber String   @default("5511999999999")
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  action     String
  resource   String
  resourceId String?
  ip         String   @default("127.0.0.1")
  details    String?
  timestamp  DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("info")
  service   String
  message   String
  stack     String?
  timestamp DateTime @default(now())
}
